<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Same folders as backup_rules.xml, for the cloud backup and for a phone to phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
